{
  "name": "@bvolpato/copy-as-markdown",
  "version": "1.4.0",
  "description": "Copy page content as clean, structured Markdown",
  "type": "module",
  "main": "./dist/library/index.js",
  "module": "./dist/library/index.js",
  "types": "./dist/library/types/library/entry.d.ts",
  "unpkg": "./dist/library/browser.js",
  "jsdelivr": "./dist/library/browser.js",
  "exports": {
    ".": {
      "types": "./dist/library/types/library/entry.d.ts",
      "import": "./dist/library/index.js"
    },
    "./core": {
      "types": "./dist/library/types/library/index.d.ts",
      "import": "./dist/library/core.js"
    },
    "./extractors/confluence": {
      "types": "./dist/library/types/extractors/confluence.d.ts",
      "import": "./dist/library/extractors/confluence.js"
    },
    "./extractors/documentation": {
      "types": "./dist/library/types/extractors/documentation.d.ts",
      "import": "./dist/library/extractors/documentation.js"
    },
    "./extractors/github": {
      "types": "./dist/library/types/extractors/github.d.ts",
      "import": "./dist/library/extractors/github.js"
    },
    "./extractors/hugging-face": {
      "types": "./dist/library/types/extractors/hugging-face.d.ts",
      "import": "./dist/library/extractors/hugging-face.js"
    },
    "./extractors/google-docs": {
      "types": "./dist/library/types/extractors/google-docs.d.ts",
      "import": "./dist/library/extractors/google-docs.js"
    },
    "./extractors/google-ai-studio": {
      "types": "./dist/library/types/extractors/google-ai-studio.d.ts",
      "import": "./dist/library/extractors/google-ai-studio.js"
    },
    "./extractors/gemini-notebook": {
      "types": "./dist/library/types/extractors/gemini-notebook.d.ts",
      "import": "./dist/library/extractors/gemini-notebook.js"
    },
    "./extractors/jira": {
      "types": "./dist/library/types/extractors/jira.d.ts",
      "import": "./dist/library/extractors/jira.js"
    },
    "./extractors/linear": {
      "types": "./dist/library/types/extractors/linear.d.ts",
      "import": "./dist/library/extractors/linear.js"
    },
    "./extractors/microsoft-copilot": {
      "types": "./dist/library/types/extractors/microsoft-copilot.d.ts",
      "import": "./dist/library/extractors/microsoft-copilot.js"
    },
    "./extractors/mistral-vibe": {
      "types": "./dist/library/types/extractors/mistral-vibe.d.ts",
      "import": "./dist/library/extractors/mistral-vibe.js"
    },
    "./extractors/deepseek": {
      "types": "./dist/library/types/extractors/deepseek.d.ts",
      "import": "./dist/library/extractors/deepseek.js"
    },
    "./extractors/microsoft-teams": {
      "types": "./dist/library/types/extractors/microsoft-teams.d.ts",
      "import": "./dist/library/extractors/microsoft-teams.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/library",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "22.22.2",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsx build/build.ts && tsc --project tsconfig.library.json",
    "build:library": "tsx build/build.ts --library-only && tsc --project tsconfig.library.json",
    "clean": "rm -rf dist",
    "rebuild": "pnpm clean && pnpm build",
    "zip:chrome": "cd dist/chrome && zip -r ../copy-as-markdown-chrome.zip .",
    "zip:firefox": "cd dist/firefox && zip -r ../copy-as-markdown-firefox.zip .",
    "package:chrome": "pnpm build && pnpm zip:chrome",
    "package:firefox": "pnpm build && pnpm zip:firefox",
    "package:all": "pnpm build && pnpm zip:chrome && pnpm zip:firefox",
    "verify:release": "tsx build/verify-release.ts",
    "test": "pnpm test:regression",
    "test:live": "pnpm build && node test/test-sites.js",
    "test:library": "pnpm build && node test/library.test.js",
    "test:ai-chat": "pnpm build && node test/ai-chat.test.js",
    "test:regression": "pnpm build && node test/library.test.js && node test/ai-chat.test.js && node test/background.test.js && node test/test-sites.js --regression && tsx test/fixtures/security.test.ts && tsx test/fixtures/verify.ts",
    "test:site": "pnpm build && node test/test-sites.js",
    "fixtures:capture": "pnpm build && tsx test/fixtures/capture.ts",
    "fixtures:verify": "pnpm build && tsx test/fixtures/verify.ts",
    "pack:library": "pnpm pack --dry-run",
    "prepack": "pnpm build:library"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bvolpato/copy-as-markdown"
  },
  "keywords": [
    "markdown",
    "copy",
    "clipboard",
    "library",
    "extractor",
    "userscript",
    "browser-extension",
    "chrome-extension",
    "firefox-extension",
    "llm",
    "chatgpt",
    "claude",
    "gemini",
    "web-scraping",
    "content-extraction"
  ],
  "author": "Bruno Volpato <brunocvcunha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bvolpato/copy-as-markdown/issues"
  },
  "homepage": "https://github.com/bvolpato/copy-as-markdown#readme",
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.7.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
